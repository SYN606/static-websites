{
  "name": "static-websites",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "serve": "bun run index.ts",
    "build:css": "tailwindcss -i ./input.css -o ./output.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ./output.css --watch",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
